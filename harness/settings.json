{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * HEAD:master*)",
      "Bash(git push --mirror*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git rm * tests/*)",
      "Bash(git rm tests/*)",
      "Bash(git rm * e2e/*)",
      "Bash(git rm e2e/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/recade-guard.mjs\" || { echo \"The Recade guard launcher .claude/hooks/recade-guard.mjs is missing or broken: write tools and Bash are refused. Run recade harness install from a terminal.\" >&2; exit 2; }"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/recade-guard.mjs\" --session-start || true",
            "timeout": 180
          }
        ]
      }
    ]
  }
}

{
  "name": "recade",
  "version": "1.8.0",
  "description": "Takes a software project from an idea to agents shipping it slice by slice, with an expert-inspired team, real documents and a human at every gate.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "recade": "bin/recade.js"
  },
  "files": [
    "bin",
    "src",
    "commands",
    "agents",
    "skills",
    "templates",
    "harness",
    "render",
    "hooks",
    "cases",
    ".claude-plugin",
    "docs/design.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test && node bin/recade.js lint-style .",
    "publish-check": "node tools/publish-check.js",
    "e2e": "node tools/e2e.js",
    "sync-shared": "node tools/sync-shared.js",
    "harness-history": "node tools/harness-history.js"
  },
  "license": "MIT",
  "dependencies": {
    "docx": "^9",
    "exceljs": "^4",
    "jszip": "^3",
    "marked": "^18",
    "playwright": "^1.65",
    "pptxgenjs": "^4",
    "yaml": "^2"
  }
}
